# Audio files
*.wav
*.WAV
*.flac

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Catalog cache files (generated by catalog/build.py)
*.parquet
*.pkl

# Generated localization output (QC plots, results)
localization/

# Demo audio (~26 GB) -- fetched via demo/assemble_demo_data.py, distributed
# separately rather than tracked in git
demo/demo_audio/
demo/outputs/

# Generated data files (catalogs, deployments, checkpoints)
data/
birdnet/checkpoints*/

# Output artifacts from catalog/reorganize.py
rename_manifest_*.json

# Site-specific config files (use birdaudio.toml.example as a template).
# Anchored to the repo root so demo/birdaudio.toml (a shipped, non-private
# demo config) is not swept up by this rule.
/birdaudio.toml
sites/
birdnet/info/

# Jupyter autosave, and generated analysis output (plots, ad hoc results)
.ipynb_checkpoints/
analysis/qcplots_*/

# macOS
.DS_Store

# IDEs
.idea/
.vscode/

# Environment
.env
*.env

# Generated analysis caches and run logs (regenerable; large in aggregate)
*.npz
*.log
analysis/soundscape/logs_3recorders/
analysis/soundscape/monthly_logs/

# User-supplied reference data managed outside git (large DEM GeoTIFFs)
user_files/

# Caller inventory outputs: regenerable from the audio with analysis/callers/*.py
analysis/callers/runs/
analysis/callers/__pycache__/
analysis/callers/blobs_*
analysis/callers/stack_*.png
